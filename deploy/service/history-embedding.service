[Unit]
Description=近代军史数智平台 嵌入模型服务端（Ollama, Qwen3-Embedding-0.6B, CPU）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11436
Environment=OLLAMA_MODELS=%h/history-service/models-embedding
# 固定 CPU，禁止嵌入占用生成模型的 GPU。
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=GGML_VK_VISIBLE_DEVICES=-1
Environment=ROCR_VISIBLE_DEVICES=-1
Environment=OLLAMA_KEEP_ALIVE=-1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_CONTEXT_LENGTH=4096
ExecStart=%h/history-service/ollama/bin/ollama serve
Restart=always
RestartSec=5
StandardOutput=append:%h/history-service/logs/embedding.log
StandardError=append:%h/history-service/logs/embedding.log

[Install]
WantedBy=default.target
