# 仅供数据端部署；由 history-data.service / literature.service 读取。
# 分别复制到 /etc/history-semantic.env 和 /etc/literature-semantic.env。
# 先在服务端安装并验证下列模型，再启用数据端。
SEMANTIC_SEARCH_ENABLED=true
EMBEDDING_API_BASE=http://127.0.0.1:11435
EMBEDDING_MODEL=qwen3-embedding:0.6b-q8_0
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=8
SEMANTIC_SCAN_INTERVAL_SECONDS=30
SEMANTIC_MIN_COSINE=0
# 未设置 EMBEDDING_QUERY_PREFIX 时，代码为上述模型添加 Instruct/Query 前缀。
# 请保持未设置；设置为空会显式禁用该前缀。
EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_API_KEY=...
